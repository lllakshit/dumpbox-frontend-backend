# Copy to .env.local for local development, then fill the two keys from `supabase status -o env`
# (PUBLISHABLE_KEY and SECRET_KEY). Never commit real keys.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server only. Never expose these to the browser.
SUPABASE_SECRET_KEY=
# Any long random string; Vercel Cron sends it as a Bearer token to /v1/internal/purge.
CRON_SECRET=
